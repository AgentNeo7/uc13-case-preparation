@IsTest private class CasePreparationActionTest {
 @IsTest static void evidenceCarriesSourceStamp() {Contact p=new Contact(LastName='Synthetic'); insert p; Case c=new Case(Subject='Synthetic',Description='Synthetic evidence',ContactId=p.Id,Status='New',Origin='Phone'); insert c; c=[SELECT Id,LastModifiedDate FROM Case WHERE Id=:c.Id]; CasePreparationAction.Request r=new CasePreparationAction.Request();r.caseId=c.Id; CasePreparationAction.Result v=CasePreparationAction.prepare(new List<CasePreparationAction.Request>{r})[0];System.assertEquals('SCOPED_FIELDS_PRESENT',v.state);System.assertEquals(c.LastModifiedDate,v.sourceModified);System.assert(v.sourceReference.contains(String.valueOf(c.Id)));}
 @IsTest static void absentCaseUnknown() {System.assertEquals('UNKNOWN',CasePreparationAction.prepare(new List<CasePreparationAction.Request>{new CasePreparationAction.Request()})[0].state);}
 @IsTest static void missingContactIncomplete() {Case c=new Case(Subject='Synthetic',Status='New',Origin='Phone');insert c; CasePreparationAction.Request r=new CasePreparationAction.Request();r.caseId=c.Id;System.assertEquals('INCOMPLETE',CasePreparationAction.prepare(new List<CasePreparationAction.Request>{r})[0].state);}
}
